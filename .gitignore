# Ignore all experiment workspaces by default; re-include the CNNDM handoff
# workspace below, then re-exclude its runtime artifacts so only source files
# are committed.
experiments/*
!experiments/0505_CNNDM_compare

# Runtime artifacts under the re-included CNNDM workspace (NEVER commit).
experiments/0505_CNNDM_compare/runs/
experiments/0505_CNNDM_compare/results/
experiments/0505_CNNDM_compare/logs/
# Project-local pip --target deps installed by setup_collab_env.sh.
# Per-user, per-machine, recreated by the setup script — never commit.
experiments/0505_CNNDM_compare/.pydeps/
# Auto-materialized per-cell smoke configs (written at smoke time; contain
# absolute paths). The committable templates are `_template_*.yaml`.
experiments/0505_CNNDM_compare/configs/_smoke/frozen_*.yaml
experiments/0505_CNNDM_compare/configs/_smoke/joint_*.yaml

# Editor / packaging artifacts
.idea/
.vscode/
*.egg-info/

.claude/
